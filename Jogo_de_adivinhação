# Jogo de Adivinhação em Python — Lógica e Controle de Fluxo

# Desenvolvimento de um jogo interativo em Python no qual o usuário deve descobrir um número secreto gerado aleatoriamente, 
dentro de um intervalo predefinido, com limite de 10 tentativas.

# O projeto aplica conceitos fundamentais de lógica de programação, utilizando o módulo "random" para geração de números 
aleatórios, estruturas condicionais ("if", "elif" e "else") para avaliar os palpites e o laço de repetição "while" 
para controlar o fluxo do jogo. A aplicação também utiliza "break" para encerrar a execução quando o número correto é 
encontrado e realiza o controle das tentativas restantes, fornecendo feedback ao usuário a cada interação.

# Tecnologias e conceitos aplicados: Python, módulo "random", estruturas condicionais, laços de repetição, controle de 
fluxo, entrada e saída de dados e lógica de programação.


import random

numero_secreto = random.randint(1, 15557)
tentativas = 10

print("🎮 JOGO: ADIVINHE O NÚMERO")
print("Estou pensando em um número de 1 a 15557.")
print("Você tem 10 tentativas!\n")

while tentativas > 0:
    print("Tentativas restantes:", tentativas)

    chute = int(input("Digite seu palpite: "))

    if chute == numero_secreto:
        print("🟩🎉 PARABÉNS! Você acertou!✔🟩")
        break

    elif chute < numero_secreto:
        print("⬆️ O número secreto é MAIOR que isso.\n")

    else:
        print("⬇️ O número secreto é MENOR que isso.\n")

    tentativas -= 1

if tentativas == 0:
    print("😢 Você perdeu!")
    print("O número secreto era:", numero_secreto)
